{
  "name": "@shadhil/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Shadhil Builders CRM — NestJS 12 REST API",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "tsx --env-file=../../.env src/main.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/schedule": "^6.0.0",
    "@shadhil/api-types": "workspace:*",
    "@shadhil/auth": "workspace:*",
    "@shadhil/database": "workspace:*",
    "@shadhil/ui-tokens": "workspace:*",
    "better-auth": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.18.0",
    "supertest": "^7.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
