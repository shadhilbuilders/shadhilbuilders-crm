{
  "name": "@shadhil/web",
  "version": "0.1.0",
  "description": "Shadhil CRM - Web app for managing your business.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "postinstall": "bash scripts/setup-env-local.sh",
    "prebuild": "pnpm --filter @shadhil/database generate && pnpm -r --filter @shadhil/database --filter @shadhil/auth --filter @shadhil/api-types run clean && pnpm --filter @shadhil/database build && pnpm --filter @shadhil/auth --filter @shadhil/api-types build",
    "build": "SERWIST_SUPPRESS_TURBOPACK_WARNING=1 next build --webpack",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "typegen": "next typegen",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0 --no-warn-ignored --cache",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md,mdx}\" --cache",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md,mdx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "clean": "rm -rf .next node_modules/.cache"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@paalstack/react-hooks": "^1.1.2",
    "@paalstack/react-icons": "^1.1.1",
    "@paalstack/react-ui": "^1.7.0",
    "@serwist/next": "9.5.12",
    "@serwist/window": "9.5.12",
    "@shadhil/api-types": "workspace:*",
    "@shadhil/auth": "workspace:*",
    "@shadhil/database": "workspace:*",
    "@shadhil/offline-store": "workspace:*",
    "@shadhil/ui-tokens": "workspace:*",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@tanstack/react-query": "^5.102.5",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "idb-keyval": "6.3.0",
    "next": "^16.3.2",
    "nextjs-toploader": "^3.9.17",
    "react": "^19.2.8",
    "react-aria-components": "^1.21.1",
    "react-day-picker": "^10.0.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-is": "^19.2.7",
    "recharts": "^3.8.1",
    "serwist": "9.5.12",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.3.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.1.11"
  }
}
