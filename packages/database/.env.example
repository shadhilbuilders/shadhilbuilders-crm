# ──────────────────────────────────────────────────────────────────────────────
# Shadhil Builders CRM - Database package env
# ──────────────────────────────────────────────────────────────────────────────
# Mirror the root .env (or rely on global envs from Turbo). The DATABASE_URL
# through PgBouncer for runtime; DIRECT_DATABASE_URL bypasses it for the
# schema/RLS bootstrap (migrations, session vars).
# ──────────────────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://shadhil:shadhil@localhost:6432/shadhil_crm?schema=public
DIRECT_DATABASE_URL=postgresql://shadhil:shadhil@localhost:5432/shadhil_crm?schema=public
POOL_MODE=session

# Seed users (mirrors .env.example §17 input #5)
SEED_OWNER_EMAIL=owner@shadhilbuilders.in
SEED_OWNER_NAME=Owner
SEED_OWNER_PASSWORD=changeme
SEED_ADMIN_EMAIL=admin@shadhilbuilders.in
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=changeme
SEED_MANAGER_EMAIL=manager@shadhilbuilders.in
SEED_MANAGER_NAME=Manager
SEED_MANAGER_PASSWORD=changeme
SEED_TELECALLER_EMAIL=telecaller@shadhilbuilders.in
SEED_TELECALLER_NAME=Telecaller
SEED_TELECALLER_PASSWORD=changeme