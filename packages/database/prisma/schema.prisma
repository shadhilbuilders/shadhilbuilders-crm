// ────────────────────────────────────────────────────────────────────────────
// Shadhil Builders CRM - Prisma schema
// ────────────────────────────────────────────────────────────────────────────
// 18 business models + 4 better-auth tables (User, Session, Account, Verification).
// User is shared between better-auth and the business layer (single source of truth).
//
// Datasource notes:
// - CLI datasource url lives in prisma.config.ts (Prisma 7: no url in schema).
// - Direct migration URL: DIRECT_DATABASE_URL (owner role; bypasses PgBouncer
//   so SET LOCAL session variables for RLS work reliably).
// - Runtime queries via PgBouncer use DATABASE_URL + withRlsContext() through
//   the @prisma/adapter-pg driver adapter (POOL_MODE must be 'session').
//
// Money: Decimal(12,2) - never Float.
// IDs: cuid() - short, sortable, URL-safe.
// ────────────────────────────────────────────────────────────────────────────

generator client {
  // Prisma 7 default generator (the old `prisma-client-js` is in maintenance
  // mode and will be removed). Emits plain TypeScript into a normal source
  // path - no more magic generation into `node_modules/.prisma/client`, no
  // more `ERR_UNSUPPORTED_DIR_IMPORT` from the consumer's bare-directory
  // import.
  //
  // moduleFormat: "cjs" - the whole backend toolchain (nest build + node
  // dist/main.js) is CommonJS; CJS require() resolves the generated code's
  // bare relative imports natively. (With "esm" the generator emits bare
  // ESM imports that Node ESM rejects.)
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
}

// ────────────────────────────────────────────────────────────────────────────
// Enums
// ────────────────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  MANAGER
  SALES_EXEC
  TELECALLER
}

enum LeadState {
  NEW
  CONTACTED
  VISIT_REQUESTED
  VISIT_SCHEDULED
  VISITED
  NEGOTIATION
  BOOKING_INITIATED
  WON
  LOST
  RNR
  RESCHEDULED
  NO_SHOW
}

enum LeadOwnerType {
  TELECALLER
  SALES_EXEC
  MANAGER
  ADMIN
}

enum ActivityType {
  CALL
  NOTE
  STATUS_CHANGE
  VISIT
  EMAIL
  ASSIGNMENT
}

enum VisitStatus {
  SCHEDULED
  RESCHEDULED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum MessageDirection {
  IN
  OUT
}

enum MessageChannel {
  WHATSAPP
  IN_APP
}

/**
 * Thread discriminator. CUSTOMER = the 1:1 staff↔customer thread
 * (IN = customer→staff, OUT = staff→customer, may enqueue WhatsApp).
 * INTERNAL = staff-only notes on the lead thread (always OUT/staff-authored,
 * never enqueues WhatsApp, team-scoped via the parent Lead's RLS).
 * Kept as a column (not a separate table) so internal notes reuse the
 * Message RLS, SSE, and pane. A future targeted mention can add a
 * recipientId column without touching this enum.
 */
enum MessageKind {
  CUSTOMER
  INTERNAL
}

enum BookingStatus {
  HOLD
  TOKEN
  APPROVED
  REJECTED
  CANCELLED
}

enum UnitStatus {
  AVAILABLE
  HOLD
  TOKEN
  SOLD
}

enum ProjectOptionType {
  FACING
  BHK
}

enum ReminderType {
  PRE_VISIT_STAFF
  PRE_VISIT_CUSTOMER
  RESCHEDULE_FOLLOWUP
  NO_SHOW_STAFF
}

enum ReminderStatus {
  SCHEDULED
  // T-G4: PROCESSING is the intermediate state during a cron's lease.
  // The processor claims rows by updateMany(SCHEDULED → PROCESSING) so a
  // second cron tick (different replica, lock expired) sees zero rows
  // and exits cleanly - no duplicate fire.
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum PushPlatform {
  WEB
  IOS
  ANDROID
}

enum PushStatus {
  PENDING
  DELIVERED
  FAILED
}

enum ConsentType {
  MARKETING
  DATA_PROCESSING
  COMMUNICATION
}

enum WebhookSource {
  WHATSAPP
  FREJUN
}

enum FeedbackStatus {
  NEW
  REVIEWED
  ARCHIVED
}

// ────────────────────────────────────────────────────────────────────────────
// 0. Organization (multi-tenant tenant axis)
// ────────────────────────────────────────────────────────────────────────────
// T-ORG (2026-09-11, eng review): Organization is the tenant boundary. A
// strict two-level hierarchy: an Organization contains Teams which contain
// Users/Leads. Every business row carries `organizationId` (denormalized on
// child rows so RLS policies compare a column, not a join). The OWNER role
// now means "org owner" - one per org (partial unique index organizations'
// owner, migration 20260911...), replacing the global one_owner.
//
// onDelete: Restrict - an org with live data cannot be deleted (cascade
// would destroy tenant history). Orgs are soft-lifecycle; deletion is a
// deliberate destructive admin op.
model Organization {
  id        String   @id @default(cuid(2))
  name      String
  slug      String   @unique
  // T-ORG-OWNER (2026-09-17): the user who created the org via self-signup
  // becomes its OWNER. createdBy records that origin (the OWNER role itself
  // already grants full access via the admin downcast); nullable because the
  // seeded bootstrap org predates the field. Set on user.create in the
  // better-auth hook; never mutated afterward.
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                   User[]
  teams                   Team[]
  projects                Project[]
  phases                  Phase[]
  units                   Unit[]
  leads                   Lead[]
  activities              Activity[]
  siteVisits              SiteVisit[]
  messages                Message[]
  bookings                Booking[]
  reminders               Reminder[]
  notifications           Notification[]
  pushSubscriptions       PushSubscription[]
  pushNotifications       PushNotification[]
  auditLogs               AuditLog[]
  consents                Consent[]
  feedbacks               Feedback[]
  webhookEvents           WebhookEvent[]
  outboundMessages        OutboundMessage[]
  whatsappUnknownContacts WhatsappUnknownContact[]
  streamTickets           StreamTicket[]
  projectOptions          ProjectOption[]
  managerAssignmentRules  ManagerAssignmentRule[]
  teamMembers             TeamMember[]
  projectTeams            ProjectTeam[]
  messageRecipients       MessageRecipient[]

  @@index([slug])
}

// ────────────────────────────────────────────────────────────────────────────
// 1. User (better-auth shape + business relations)
// ────────────────────────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(cuid())
  // T-EMAIL-PER-ORG (2026-10-04): email uniqueness is scoped to the
  // organization, not global - two different orgs may each have their own
  // "owner@gmail.com". This used to be a bare `@unique`, which meant an
  // ADMIN creating a user in Org A got a raw Prisma P2002/500 if that email
  // already existed in a COMPLETELY UNRELATED Org B. See the `@@unique`
  // below for the real constraint and users.service.ts's create()/update()
  // for the friendly-message catch.
  //
  // CAVEAT (accepted, flagged per AGENTS.md "flag then follow"): better-auth
  // email/password sign-in (packages/auth-client/src/auth.ts) looks a user
  // up by email ALONE (findUserByEmail → adapter findFirst, no org/tenant
  // filter) because /login is a single global route with no org context.
  // If the SAME email is ever created in two different orgs, sign-in
  // resolves to whichever row Postgres returns first - there is no login-
  // flow change in this cut to disambiguate by org. Accepted tradeoff per
  // explicit product decision; revisit if cross-org duplicate emails
  // actually occur (e.g. org-aware login or an email-verification gate).
  email              String
  emailVerified      Boolean   @default(false)
  name               String
  image              String?
  phone              String?
  role               Role      @default(TELECALLER)
  // T-ORG: every user belongs to exactly one organization (the tenant).
  // Team membership is a TeamMember row (many-to-many), not a scalar on User.
  organizationId     String
  // T-SOFT-DELETE (2026-09-09): soft-delete sentinel. NULL = active; set =
  // the user is soft-deleted (blocked from sign-in, hidden from all lists).
  // ADMIN/OWNER only. Hard-delete is removed - the account row is kept so
  // audit/session history survives; login rejects deletedAt <> null.
  deletedAt          DateTime?
  // Placeholder-password gate (T-S hardening, 2026-09-04; re-scoped
  // 2026-09-15). When true, the JwtAuthGuard rejects every authenticated
  // request with a 403 + PASSWORD_CHANGE_REQUIRED, and the web client bounces
  // to /change-password.
  //
  // ONLY THE OWNER IS GATED (2026-09-15). The default is FALSE because the
  // other four roles start ungated; the seed arms the gate for the OWNER
  // account alone (`mustChangePassword: role === 'OWNER'`), which is the
  // single highest-privilege account and the only one that cannot be created
  // or reassigned into through the API.
  //
  // The feature was NOT removed: /change-password, the guard's check, the
  // service's flip-to-false write and the BFF's 403 handler all still work.
  // Setting this column to true for any user re-arms the gate for that user.
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // better-auth relations
  sessions Session[]
  accounts Account[]

  // business relations
  organization              Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  // T-TEAM-AUTHORITATIVE (2026-09-13): TeamMember is the sole
  // user↔team membership record. Managers also participate via
  // Team.managerId (managedTeams). See Decision Audit Trail #39/#40.
  teamMemberships           TeamMember[]       @relation("TeamMembershipUser")
  teamMembershipsAssignedBy TeamMember[]       @relation("TeamMembershipAssignedBy")
  projectTeamsAssignedBy    ProjectTeam[]      @relation("ProjectTeamAssignedBy")
  managedTeams              Team[]             @relation("TeamManager")
  defaultAssigneeOf         Team[]             @relation("TeamDefaultAssignee")
  ownedLeads                Lead[]             @relation("LeadOwner")
  coOwnedLeads              Lead[]             @relation("LeadCoOwner")
  activities                Activity[]
  messages                  Message[]
  messageRecipients         MessageRecipient[] @relation("MessageRecipientUser")
  chatReadStates            ChatReadState[]
  reminders                 Reminder[]
  notifications             Notification[]
  siteVisits                SiteVisit[]
  bookingsCreated           Booking[]          @relation("BookingCreatedBy")
  bookingsApproved          Booking[]          @relation("BookingApprovedBy")
  pushSubscriptions         PushSubscription[]
  pushNotifications         PushNotification[]
  auditLogs                 AuditLog[]
  streamTickets             StreamTicket[]
  banned                    Boolean?
  banReason                 String?
  banExpires                DateTime?

  // better-auth admin() plugin fields (AR-8: required by admin plugin user model)

  @@index([organizationId])
  @@index([role])
  // T-EMAIL-PER-ORG (2026-10-04): replaces the old bare `@@index([email])` +
  // column-level `@unique` - uniqueness is now scoped to the org (see the
  // comment on `email` above). Still serves as the lookup index for the
  // global-by-email reads (better-auth's findUserByEmail, @@index([email])
  // callers), since a composite index's leading column (`email`) is usable
  // on its own.
  @@unique([email, organizationId])
}

// ────────────────────────────────────────────────────────────────────────────
// 2. Team
// ────────────────────────────────────────────────────────────────────────────

model Team {
  id                String    @id @default(cuid())
  name              String
  managerId         String?
  // T-ORG: teams nest inside an organization (tenant). Referential
  // integrity guarantees a team can't span orgs.
  organizationId    String
  // T-ARM-SCHEMA (2026-09-04): per-team fallback assignee. The
  // ManagerAssignmentRule engine falls back to this user when no
  // rule matches the lead's criteria. The target must still be
  // TELECALLER or SALES_EXEC (the engine rejects ADMIN/MANAGER).
  // nullable: a team without a default assignee → leads that don't
  // match any rule stay unassigned (notification trigger fires).
  defaultAssigneeId String?
  // T-AUTOASSIGN (2026-09-17): how this team routes NEW leads.
  //   true  = auto-assign across ALL project teams (least-loaded TELECALLER
  //          by openLeads/weight; sales execs are NOT candidates - a NEW lead
  //          is telecaller work, so with no eligible telecaller the lead goes
  //          to this team's manager as a pending handoff).
  //   false = new leads land owned by this team's MANAGER (pending state),
  //          who then reassigns to a specific telecaller. Manager owns until
  //          handoff (LeadOwnerType.MANAGER).
  autoAssignLeads   Boolean   @default(false)
  createdAt         DateTime  @default(now())
  // T-TEAM-CRUD (2026-09-13): NULL = active; set = soft-deleted (hidden
  // from the org-Teams pages). Mirrors Project.deletedAt exactly - avoids
  // Lead.teamId's onDelete:Restrict hard-delete trap and keeps historical
  // Lead/ManagerAssignmentRule references intact.
  deletedAt         DateTime?

  manager         User?                   @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  defaultAssignee User?                   @relation("TeamDefaultAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  leads           Lead[]
  assignmentRules ManagerAssignmentRule[]
  teamMembers     TeamMember[]
  projectTeams    ProjectTeam[]

  // T-TEAM-CRUD: per-org name uniqueness, mirrors Project's
  // @@unique([organizationId, slug]) exactly (plain composite - not
  // soft-delete-aware, same tradeoff Project already accepts).
  @@unique([organizationId, name])
  @@index([managerId])
  @@index([defaultAssigneeId])
  @@index([organizationId])
}

// ────────────────────────────────────────────────────────────────────────────
// 2b. TeamMember (additive multi-team staff↔team join)
// ────────────────────────────────────────────────────────────────────────────
// T-TEAM-AUTHORITATIVE (2026-09-13, design doc in Decision Audit Trail #39/#40):
// authoritative "which teams does this person belong to" join. A user may
// hold many rows (one per team, composite PK). The team's manager
// participates through `Team.managerId` and does NOT need a duplicate row
// here unless they also serve as an ordinary member of a DIFFERENT team.
model TeamMember {
  userId         String
  teamId         String
  // T-ORG: denormalized tenant axis so RLS compares a column, not a join.
  organizationId String
  assignedAt     DateTime @default(now())
  assignedById   String?
  // T-AUTOASSIGN (2026-09-17): relative routing weight for auto-assignment.
  // Higher = gets MORE leads when the team spreads new work. Default 1 for
  // everyone; an admin can bias toward an experienced telecaller (e.g. 2 =
  // twice the share of a weight-1 member). Availability = open-lead count;
  // the engine assigns to the member with the lowest openLeads / weight.
  // Only TELECALLER membership rows are routed (2026-09-28): sales execs are
  // outside the auto-assign pool, so their weight is stored but inert.
  weight         Int      @default(1)
  // T-MAXOPENLEADS (2026-09-28): hard ceiling on how many OPEN leads (non-
  // terminal states) this member may hold before auto-assign stops routing to
  // them. A different axis from `weight`: weight decides the SHARE among
  // eligible members, this decides ELIGIBILITY. Once openLeads >= maxOpenLeads
  // the member is skipped entirely, and if every telecaller in the project is
  // capped the lead goes to the creating team's manager (pending handoff) -
  // never a sales exec, never silently over the cap.
  // NULL = no cap (opt-in), so every existing row keeps its current behavior.
  // NOT 0-as-default: 0 is a meaningful "takes no more leads" ceiling, and
  // conflating it with "unset" would silently strand a team.
  maxOpenLeads   Int?

  user         User         @relation("TeamMembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedBy   User?        @relation("TeamMembershipAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, teamId])
  @@index([userId])
  @@index([teamId])
  @@index([organizationId])
}

// ────────────────────────────────────────────────────────────────────────────
// 4c. ProjectTeam (additive team↔project join; replaces ProjectMember)
// ────────────────────────────────────────────────────────────────────────────
// T-TEAM-AUTHORITATIVE (2026-09-13): projects link to TEAMS, never directly
// to users. Effective project staff = union of every TeamMember (+ the
// team's manager) across every team linked via ProjectTeam.
model ProjectTeam {
  projectId      String
  teamId         String
  // T-ORG: denormalized tenant axis so RLS compares a column, not a join.
  organizationId String
  assignedAt     DateTime @default(now())
  assignedById   String?
  // T-TEAM-ROUND-ROBIN (2026-10-08): rotation cursor for auto-assign. The team
  // that was routed to longest ago (NULL = never) goes next. Advanced only via
  // advance_project_team_cursor() (SECURITY DEFINER) - ProjectTeam writes are
  // ADMIN-only under RLS, and the creating user is usually not an admin.
  lastAssignedAt DateTime?

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedBy   User?        @relation("ProjectTeamAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([projectId, teamId])
  @@index([projectId])
  @@index([teamId])
  @@index([organizationId])
}

// ────────────────────────────────────────────────────────────────────────────
// 3. ManagerAssignmentRule (auto-routing)
// ────────────────────────────────────────────────────────────────────────────

model ManagerAssignmentRule {
  id             String   @id @default(cuid())
  teamId         String
  organizationId String
  source         String // e.g. "meta_ads", "website", "referral"
  targetUserId   String
  // T-ARM-SCHEMA (2026-09-04, Plan §18 D2): priority-ordered routing.
  // Lower number = higher priority (CSS-like). Two rules with the same
  // priority fall through to createdAt ASC tiebreak. Default 0 so the
  // existing single-rule setup behaves identically.
  priority       Int      @default(0)
  // Optional criteria - when present, the rule only matches leads where
  // the same attribute equals this value. NULL = wildcard (rule matches
  // any value). All four columns are independent: a rule with
  // projectId="A" AND phaseId=null matches leads in project A regardless
  // of phase. Combined with the priority ordering, a team can declare:
  //   (priority 10, projectId=A, source=META_AD) → senior TC
  //   (priority 20, projectId=A)                → TC pool
  //   (priority 30)                             → catch-all
  projectId      String?
  phaseId        String?
  language       String? // ISO 639-1 short code: "en", "hi", "ta"
  region         String? // ISO 3166-1 / UN region: "IN-TN", "IN-KA"
  // targetUserId may point at a TELECALLER or a SALES_EXEC. Role is NOT
  // constrained here on purpose (2026-09-28): the rule records operator
  // intent, and the create-time engine decides whether it may fire. A NEW
  // lead is telecaller work (plan §3), so `evaluateAssignment(...,
  // 'new-lead')` skips an exec target on lead-create; the same rule would be
  // honoured by a wider-mode caller. See AssignmentMode in
  // apps/backend/src/leads/manager-assignment.engine.ts.
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Composite unique - the previous [teamId, source] constraint forced
  // one rule per (team, source). The widened constraint lets a team
  // declare multiple rules for the same source differentiated by
  // priority + criteria (e.g. "META_AD on project A" vs "META_AD on
  // project B" both coexist).
  @@unique([teamId, source, priority, projectId, phaseId, language, region], name: "teamId_source_priority_projectId_phaseId_language_region")
  @@index([teamId])
  @@index([organizationId])
  @@index([targetUserId])
  @@index([priority])
}

// ────────────────────────────────────────────────────────────────────────────
// 4. Project
// ────────────────────────────────────────────────────────────────────────────

model Project {
  id             String    @id @default(cuid())
  name           String
  // T-ORG: slug uniqueness is now per-org (two orgs may each have a
  // "shadhil-metro-heights"). The old global `slug @unique` is replaced
  // by the composite @@unique([organizationId, slug]) below.
  slug           String
  // T-ORG: tenant axis.
  organizationId String
  address        String
  reraNumber     String?
  cmdaNumber     String?
  createdAt      DateTime  @default(now())
  // T-SOFT-DELETE (2026-09-09): NULL = active; set = soft-deleted (hidden
  // from registry/switcher/staff page). ADMIN + OWNER only.
  deletedAt      DateTime?

  phases         Phase[]
  leads          Lead[]
  projectTeams   ProjectTeam[]
  projectOptions ProjectOption[]
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
  @@index([slug])
  @@index([organizationId])
}

// ────────────────────────────────────────────────────────────────────────────
// 5. Phase
// ────────────────────────────────────────────────────────────────────────────

model Phase {
  id             String   @id @default(cuid())
  projectId      String
  // T-ORG: denormalized tenant axis.
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  units        Unit[]

  @@index([projectId])
  @@index([organizationId])
}

// ────────────────────────────────────────────────────────────────────────────
// 5b. ProjectOption (per-project facing/BHK picker values)
// ────────────────────────────────────────────────────────────────────────────
// Per-project option sets that the inventory pickers read from. Facing and
// BHK were static constants; making them per-project data lets a project
// define its own facing list and BHK range. One table with a `type`
// discriminator (FACING | BHK) = one CRUD surface + one RLS policy.
//
// `value` is a free-form string ('North', '1', ...); BHK is converted to an
// int when applied to a Unit. Unique on (projectId, type, value) so a
// project can't hold duplicate options. A value in use by a unit in the
// project cannot be deleted (409 - service guard preserves referential
// integrity across the type-erased string column).
model ProjectOption {
  id             String            @id @default(cuid())
  projectId      String
  // T-ORG: denormalized tenant axis.
  organizationId String
  type           ProjectOptionType
  value          String
  createdAt      DateTime          @default(now())

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([projectId, type, value])
  @@index([projectId, type])
  @@index([organizationId])
}

// ────────────────────────────────────────────────────────────────────────────
// 6. Unit (money lives here - Decimal(12,2))
// ────────────────────────────────────────────────────────────────────────────

model Unit {
  id             String     @id @default(cuid())
  phaseId        String
  // T-ORG: denormalized tenant axis.
  organizationId String
  unitNumber     String
  bhk            Int
  facing         String?
  sqft           Int?
  price          Decimal    @db.Decimal(12, 2)
  status         UnitStatus @default(AVAILABLE)
  createdAt      DateTime   @default(now())

  phase        Phase        @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings     Booking[]

  @@unique([phaseId, unitNumber])
  @@index([phaseId])
  @@index([organizationId])
  @@index([status])
}

// ────────────────────────────────────────────────────────────────────────────
// 7. Lead (core CRM entity)
// ────────────────────────────────────────────────────────────────────────────

model Lead {
  id                  String        @id @default(cuid())
  name                String
  // T-E2b (2026-09-04): `phone` keeps the user-entered display format
  // (e.g. "98765 43210"); `phoneE164` is the E.164-normalized form
  // (e.g. "919876543210"). Outbound WhatsApp sends to phoneE164;
  // inbound webhook looks up by phoneE164. The unique index on phone
  // stays for display-layer dedup; phoneE164 has its own unique index.
  // Existing rows are backfilled by the 2026_09_04_t_e2b_phone_e164
  // migration (UPDATE ... SET phoneE164 = digits-only-of-phone).
  phone               String        @unique
  phoneE164           String?       @unique
  email               String?
  source              String?
  state               LeadState     @default(NEW)
  ownerId             String
  ownerType           LeadOwnerType
  coOwnerId           String?
  teamId              String
  // T-ORG: tenant axis (denormalized to every lead-scoped child too, so
  // RLS on child tables compares a column, not a join to Lead).
  organizationId      String
  // T-LEAD-PROJECT-REQUIRED (2026-09-16, owner ruling): a lead MUST belong to a
  // project. It was `String?`, and `leads.service.create` wrote
  // `dto.projectId ?? null`, so leads could be created belonging to no project.
  //
  // Why this is a DB constraint and not just DTO validation: 140 project-less
  // leads accumulated in three days, every one of them created by a RAW INSERT
  // in a test suite. Prisma's `@relation` does not validate on raw SQL, and no
  // application-layer check ever runs for those paths - only a column constraint
  // stops them.
  //
  // The consequence they caused: a lead with no project is invisible on every
  // project-scoped surface (the work dashboard, the leads inbox) while still
  // counting org-wide - so a correct `0` on the dashboard looked like a broken
  // counter. Orphans are data corruption, not a display bug.
  //
  // `onDelete: Restrict` replaces `SetNull`: deleting a project must not be able
  // to re-create project-less leads as a side effect. Reassign the leads first.
  projectId           String
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  // T-OVERDUE-ALERTS (2026-09-18): last time the overdue-alert cron pushed a
  // reminder for this lead (owner/team-manager/org-owner). NULL = never nagged.
  // Drives the every-1-hour cadence: the cron only re-pushes leads whose last
  // stamp is older than 1h (or NULL).
  lastOverduePushedAt DateTime?

  owner            User              @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  coOwner          User?             @relation("LeadCoOwner", fields: [coOwnerId], references: [id], onDelete: SetNull)
  team             Team              @relation(fields: [teamId], references: [id], onDelete: Restrict)
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  activities       Activity[]
  visits           SiteVisit[]
  messages         Message[]
  messageRecipients MessageRecipient[] @relation("MessageRecipientLead")
  outboundMessages OutboundMessage[]
  chatReadStates   ChatReadState[]
  bookings         Booking[]
  reminders        Reminder[]
  consents         Consent[]

  @@index([ownerId])
  @@index([coOwnerId])
  @@index([teamId])
  @@index([organizationId])
  @@index([state])
  @@index([projectId])
  @@index([createdAt])
}

// ────────────────────────────────────────────────────────────────────────────
// 8. Activity (timeline entries on a Lead)
// ────────────────────────────────────────────────────────────────────────────

model Activity {
  id             String       @id @default(cuid())
  leadId         String
  // T-ORG: denormalized from parent Lead (RLS compares a column, no join).
  organizationId String
  userId         String
  type           ActivityType
  body           String       @db.Text
  createdAt      DateTime     @default(now())

  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([organizationId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// ────────────────────────────────────────────────────────────────────────────
// 9. SiteVisit
// ────────────────────────────────────────────────────────────────────────────

model SiteVisit {
  id             String      @id @default(cuid())
  leadId         String
  // T-ORG: denormalized from parent Lead.
  organizationId String
  userId         String
  scheduledFor   DateTime
  status         VisitStatus @default(SCHEDULED)
  outcome        String?     @db.Text
  notes          String?     @db.Text
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([organizationId])
  @@index([userId])
  @@index([scheduledFor])
  @@index([status])
}

// ────────────────────────────────────────────────────────────────────────────
// 10. Message (WhatsApp + in-app; used for SSE resume via createdAt)
// ────────────────────────────────────────────────────────────────────────────

model Message {
  id             String           @id @default(cuid())
  // T-WA-INBOX (2026-09-25): a Message belongs to EXACTLY ONE thread:
  // either a Lead (the 1:1 staff<->customer thread for a known contact) or a
  // WhatsappUnknownContact (a number that is not a lead yet). Previously
  // leadId was NOT NULL, which made non-lead WhatsApp traffic impossible to
  // store as history - the unknown-contact table only kept counters
  // (messageCount + firstMessageBody), so a conversation with an unknown
  // number could not exist and could not be displayed.
  //
  // Both columns are nullable because either may be unset; the
  // message_thread_exactly_one CHECK constraint in the migration enforces
  // that exactly one IS set. Keeping ONE message table (rather than a second
  // conversation table) means the chat pane, the SSE chat:<id> channel, the
  // media path, unread counting and the outbound cron all work on both
  // thread types with no parallel implementation.
  leadId         String?
  contactId      String?
  // T-ORG: denormalized from parent thread.
  organizationId String
  userId         String? // null = inbound from customer
  direction      MessageDirection
  channel        MessageChannel
  kind           MessageKind      @default(CUSTOMER)
  body           String           @db.Text
  mediaUrl       String?
  // MEDIA (2026-09-18): the PROVIDER-NEUTRAL storage key (ImageKit filePath,
  // R2 object key, local disk path). This is canonical for rows written from
  // now on; the display URL is DERIVED from it per request (media-display.ts)
  // so the storage provider is never baked into a stored row - switching
  // ImageKit -> R2 becomes an adapter change, not a data migration.
  // Mirrors OutboundMessage.mediaKey (which the cron uses to read bytes back).
  mediaKey       String?
  // MEDIA (2026-09-17): attachment metadata mirrored from the upload so the
  // web pane can render images inline vs documents as a download link, and
  // inbound WhatsApp media (2B) can store the mime type for the same render.
  mediaType      String?
  mediaFilename  String?
  externalId     String? // WhatsApp message id (for dedupe / status sync)
  createdAt      DateTime         @default(now())

  lead         Lead?                    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact      WhatsappUnknownContact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  outbound     OutboundMessage?
  recipients   MessageRecipient[]

  @@index([leadId])
  @@index([contactId])
  @@index([organizationId])
  @@index([userId])
  @@index([channel, createdAt])
  @@index([externalId])
}

// ────────────────────────────────────────────────────────────────────────────
// 10c. MessageRecipient (TARGETED @mention) - T-MENTION-TARGET (2026-09-29)
// ────────────────────────────────────────────────────────────────────────────

/**
 * One addressed recipient of an INTERNAL note - the record that makes an
 * `@mention` a real grant rather than a name-shaped guess.
 *
 * WHY IT EXISTS. `emitMentions` used to resolve `@Name` against `User.name`
 * with NO team narrowing for ordinary staff, then put `body.slice(0, 100)` in a
 * `chat.mention` notification. Two defects followed:
 *   1. A telecaller could surface a lead's internal note to ANY same-named user
 *      in the whole organization.
 *   2. The mentioned teammate could not open the lead (RLS gates Message on the
 *      parent Lead's owner/co-owner), so the notification quoted text they had
 *      no way to read the rest of - or to act on.
 *
 * `userId` is the recipient picked in the composer, not a name match, so a
 * mention can no longer land on a stranger with the same display name.
 *
 * DENORMALIZED COLUMNS ARE LOAD-BEARING, not denormalization for speed:
 *   - `leadId` mirrors the parent Message's leadId.
 *   - `organizationId` mirrors the parent Message's org (same reason
 *     Message.organizationId exists).
 * Both let EVERY policy on this table test its OWN columns only. If the policies
 * joined back through `Message` or `Lead`, Postgres would have a policy cycle:
 * `Lead`'s policy reads this table and this table's policy reads `Lead` back -
 * `infinite recursion detected in policy for relation "Lead"`, raised only at
 * SELECT time, so a clean migration is not evidence of safety.
 */
model MessageRecipient {
  id             String   @id @default(cuid())
  messageId      String
  userId         String
  /// Parent message's lead, denormalized so policies never traverse Message.
  leadId         String?
  /// Parent message's org, denormalized (mirrors Message.organizationId).
  organizationId String
  createdAt      DateTime @default(now())

  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user         User         @relation("MessageRecipientUser", fields: [userId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation("MessageRecipientLead", fields: [leadId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// A user is addressed once per message.
  @@unique([messageId, userId])
  @@index([userId, leadId])
  @@index([leadId])
  @@index([organizationId])
}

// ────────────────────────────────────────────────────────────────────────────
// 10b. ChatReadState (per-USER read position on a chat thread) - T-WA-INBOX
// ────────────────────────────────────────────────────────────────────────────

/**
 * Read position for ONE user on ONE thread.
 *
 * Why per-user and not a `lastReadAt` column on the thread: three managers
 * share the same WhatsApp thread, and one reading it must not clear the
 * others' unread badges. Unread is a property of (user, thread), so it is
 * its own row. Keyed on whichever thread column is set - the
 * chat_read_state_thread_exactly_one CHECK mirrors Message's.
 *
 * `lastReadAt` is a high-water mark, NOT a list of read message ids: a
 * message counts as unread when `createdAt > lastReadAt` AND it is inbound
 * (direction = IN). Outbound messages never contribute to unread.
 */
model ChatReadState {
  id        String   @id @default(cuid())
  userId    String
  leadId    String?
  contactId String?
  lastReadAt DateTime @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead         Lead?                   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact      WhatsappUnknownContact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  // One row per user per thread. Postgres treats NULLs as distinct, so these
  // are complemented by two partial unique indexes in the migration
  // (a plain @@unique would allow duplicate rows where one column is NULL).
  @@index([userId, leadId])
  @@index([userId, contactId])
}

// ────────────────────────────────────────────────────────────────────────────
// 11. Booking (lead × unit; money Decimal(12,2))
// ────────────────────────────────────────────────────────────────────────────

model Booking {
  id             String        @id @default(cuid())
  leadId         String
  unitId         String
  // T-ORG: denormalized from parent Lead.
  organizationId String
  userId         String // who created the booking
  amount         Decimal       @db.Decimal(12, 2)
  status         BookingStatus @default(HOLD)
  tokenAmount    Decimal?      @db.Decimal(12, 2)
  approvedById   String?
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  unit         Unit         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation("BookingCreatedBy", fields: [userId], references: [id], onDelete: Restrict)
  approvedBy   User?        @relation("BookingApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([organizationId])
  @@index([unitId])
  @@index([userId])
  @@index([status])
}

// ────────────────────────────────────────────────────────────────────────────
// 12. Reminder
// ────────────────────────────────────────────────────────────────────────────

model Reminder {
  id             String         @id @default(cuid())
  leadId         String
  // T-ORG: denormalized from parent Lead.
  organizationId String
  userId         String
  type           ReminderType
  status         ReminderStatus @default(SCHEDULED)
  scheduledFor   DateTime
  sentAt         DateTime?
  // T-G4: claim bookkeeping. When the cron claims a row (updateMany
  // SCHEDULED → PROCESSING), it sets claimedAt + claimedBy (replica id).
  // A stuck PROCESSING row (cron died mid-fire) can be recovered by:
  //   UPDATE "Reminder" SET status = 'SCHEDULED', claimedAt = NULL
  //   WHERE status = 'PROCESSING' AND claimedAt < NOW() - INTERVAL '5m'
  // The recovery job ships separately (post-Week 7 reminders module);
  // for now, a manual query is sufficient.
  claimedAt      DateTime?
  claimedBy      String?
  createdAt      DateTime       @default(now())

  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([organizationId])
  @@index([userId])
  @@index([status])
  @@index([scheduledFor])
  @@index([status, scheduledFor])
}

// ────────────────────────────────────────────────────────────────────────────
// 13. Notification (in-app inbox - supersedes the dropped InAppNotification)
// ────────────────────────────────────────────────────────────────────────────

model Notification {
  id             String   @id @default(cuid())
  userId         String
  // T-ORG: denormalized from the owning User.
  organizationId String
  type           String // free-form: "lead.assigned", "visit.scheduled", etc.
  title          String
  body           String   @db.Text
  leadId         String?
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([organizationId])
  @@index([userId, createdAt])
}

// ────────────────────────────────────────────────────────────────────────────
// 14. PushSubscription (web push per-device endpoint)
// ────────────────────────────────────────────────────────────────────────────

model PushSubscription {
  id             String       @id @default(cuid())
  userId         String
  // T-ORG: denormalized from the owning User.
  organizationId String
  endpoint       String       @unique
  p256dh         String
  auth           String
  platform       PushPlatform
  createdAt      DateTime     @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
}

// ────────────────────────────────────────────────────────────────────────────
// 15. PushNotification (delivery log)
// ────────────────────────────────────────────────────────────────────────────

model PushNotification {
  id             String     @id @default(cuid())
  userId         String
  // T-ORG: denormalized from the owning User.
  organizationId String
  type           String
  payload        Json
  status         PushStatus @default(PENDING)
  sentAt         DateTime?
  error          String?    @db.Text
  createdAt      DateTime   @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
}

// ────────────────────────────────────────────────────────────────────────────
// 16. AuditLog (before/after JSON snapshots)
// ────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  userId         String?
  // T-ORG: denormalized from the acting User. Audit rows are org-scoped so
  // an admin only sees their own org's audit trail.
  organizationId String
  action         String // "lead.update", "booking.approve", etc.
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  reason         String?  @db.Text
  ipAddress      String?
  userAgent      String?  @db.Text
  // T-TEAM-AUTHORITATIVE (2026-09-13): groups every row written inside one
  // multi-row transaction (e.g. N lead-ownership transfers + 1 membership
  // removal) so the Audit page can render/collapse them as one operation.
  // Not unique - many rows share a batchId. Nullable: unrelated actions
  // (e.g. a single lead.update) never set it.
  batchId        String?
  // T-TEAM-AUTHORITATIVE: client-generated UUID carried ONLY on the
  // membership-removal row, for idempotent replay of
  // POST /api/teams/:teamId/members/:userId/reassign-and-remove. Unique
  // (not per-org) - a requestId is a one-shot token regardless of tenant.
  requestId      String?  @unique
  createdAt      DateTime @default(now())

  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@index([batchId])
}

// ────────────────────────────────────────────────────────────────────────────
// 17. Consent (RERA / DPDP compliance trail)
// ────────────────────────────────────────────────────────────────────────────

model Consent {
  id             String      @id @default(cuid())
  leadId         String
  // T-ORG: denormalized from parent Lead.
  organizationId String
  consentType    ConsentType
  granted        Boolean
  grantedAt      DateTime
  ipAddress      String?
  source         String // "web_form", "call_verbal", "whatsapp_button", etc.
  createdAt      DateTime    @default(now())

  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([organizationId])
  @@index([consentType])
}

// ────────────────────────────────────────────────────────────────────────────
// 18. Feedback (public submissions from the landing page)
// ────────────────────────────────────────────────────────────────────────────
// Customer feedback submitted via the landing page (app/feedback). The
// landing page calls POST /api/public/feedback (a public, API-key-gated
// endpoint) so feedback now lands in the CRM database instead of Supabase.
// The table is deliberately STANDALONE - no FK to User/Lead/Project:
//   1. The submitter is a site visitor, not a staff user; we never want
//      a required team/owner column or cascade behaviour here.
//   2. `project` is a free-form display string (the landing's project slug,
//      e.g. "shadhil-metro-heights"), not a Project id. Keeping it a plain
//      string lets the landing page evolve its own catalogue without a
//      migration here.
//   rating is 1-5 (Int), validated by the public DTO AND the DB CHECK.
//   status drives the admin triage surface (NEW -> REVIEWED -> ARCHIVED).
//   ipAddress / userAgent are captured server-side for abuse analysis; they
//   are NOT part of the public request body (clients can't spoof them).
model Feedback {
  id             String         @id @default(cuid())
  name           String?
  phone          String?
  // T-ORG: public submissions resolve their org from the API key at the
  // public feedback endpoint. Required (NOT NULL) - every feedback row
  // belongs to the org that owns the submitting landing property.
  organizationId String
  rating         Int
  project        String?
  message        String?        @db.Text
  page           String?
  userAgent      String?
  ipAddress      String?
  status         FeedbackStatus @default(NEW)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([organizationId])
  @@index([createdAt])
  @@index([rating])
}

// ────────────────────────────────────────────────────────────────────────────

model WebhookEvent {
  id             String        @id @default(cuid())
  source         WebhookSource
  // T-ORG: webhook payloads carry their org (resolved from the WhatsApp
  // business number at ingest). An org-less webhook is rejected.
  organizationId String
  externalId     String        @unique
  payload        Json
  processed      Boolean       @default(false)
  processedAt    DateTime?
  error          String?       @db.Text
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([source])
  @@index([organizationId])
  @@index([processed])
}

// ────────────────────────────────────────────────────────────────────────────
// T-E2b (2026-09-04): Outbound message queue
// ────────────────────────────────────────────────────────────────────────────
// The chat service writes Message + OutboundMessage in one transaction
// (so a failed message insert never leaves a half-sent outbox row). A
// cron processor scans OutboundMessage WHERE status = 'PENDING' and
// calls the Meta WhatsApp Cloud API, updating status to SENT/FAILED
// based on the response. The same claim-leasing pattern as Reminder
// (T-G4) prevents duplicate sends if the cron runs on multiple
// replicas.
//
// `wamid` is Meta's message ID returned from the send call - used by
// the status-callback webhook to correlate delivery receipts back to
// our outbox row. The unique constraint is per-attempt; retries on
// the same message get fresh `wamid` values (which we don't need to
// keep - only the latest is meaningful for the delivery-receipt
// correlation).
model OutboundMessage {
  id             String           @id @default(cuid())
  // FK to Message. 1:1 - one outbox row per outbound message. Cascade
  // delete so removing a Message also removes its outbox row (e.g. on
  // a chat retract - not implemented yet but the schema supports it).
  messageId      String           @unique
  // T-WA-INBOX (2026-09-25): mirrors Message - an outbound row targets the
  // same single thread (lead OR unknown contact). The cron resolves the
  // destination phone from whichever is set.
  leadId         String?
  contactId      String?
  // T-ORG: denormalized from parent thread.
  organizationId String
  // Send type: FREEFORM (within 24h of lead's last inbound) or TEMPLATE
  // (after 24h, or for proactive outreach like the visit_followup and
  // visit_reminder templates). Recorded for analytics - "how much of our
  // outbound is 24h+?" is a useful business question.
  sendType       OutboundSendType @default(FREEFORM)
  // Template name + variable values, populated when sendType=TEMPLATE.
  // For FREEFORM, templateName is null and templateVars is null.
  templateName   String?
  templateVars   Json?
  // Freeform text body, populated when sendType=FREEFORM. Truncated
  // to 1000 chars by the chat service before write (leaves headroom
  // under Meta's 1024-char limit).
  freeformBody   String?          @db.Text
  // MEDIA (2026-09-17): set when the staff message carries an attachment.
  // mediaKey is the storage key (same value the Message.mediaUrl holds);
  // mediaType + mediaFilename drive the Meta /media upload for outbound.
  // When populated, the cron uploads the bytes then sends a media message
  // instead of (or in addition to) a text body.
  mediaKey       String?
  mediaType      String?
  mediaFilename  String?
  status         OutboundStatus   @default(PENDING)
  attempts       Int              @default(0)
  lastAttemptAt  DateTime?
  lastError      String?          @db.Text
  // Meta's message ID, set on successful send. Used by the status
  // webhook to update status (sent → delivered → read).
  wamid          String?
  // T-G4-style claim bookkeeping, for the cron lease pattern.
  claimedAt      DateTime?
  claimedBy      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  message      Message                  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  lead         Lead?                    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact      WhatsappUnknownContact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, lastAttemptAt]) // cron scan: PENDING rows that aren't being retried too soon
  @@index([leadId])
  @@index([contactId])
  @@index([organizationId])
  @@index([wamid])
}

enum OutboundSendType {
  FREEFORM
  TEMPLATE
}

enum OutboundStatus {
  PENDING
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
}

// ────────────────────────────────────────────────────────────────────────────
// better-auth tables (Session / Account / Verification)
// User is shared (defined above) - single source of truth.
// ────────────────────────────────────────────────────────────────────────────

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model Account {
  id           String    @id @default(cuid())
  userId       String
  accountId    String
  providerId   String
  // better-auth >=1.7 writes issuer on credential accounts ("local:credential")
  issuer       String?
  accessToken  String?   @db.Text
  refreshToken String?   @db.Text
  idToken      String?   @db.Text
  expiresAt    DateTime?
  password     String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

// Jwks - required by better-auth's jwt() plugin (HS256 mode still creates the
// key store lazily on first token request). Its absence breaks
// GET /api/auth/get-session with "Model jwks does not exist" (500), which
// takes down authClient.useSession() across the web UI. Column set follows
// better-auth 1.7's jwt() plugin schema (publicKey/privateKey/createdAt
// required; expiresAt/alg/crv/n/e optional - they ARE written even in
// HS256/EdDSA lazy-key mode, so they must exist, not just be nullable).
model Jwks {
  id         String    @id @default(cuid())
  publicKey  String    @db.Text
  privateKey String    @db.Text
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  alg        String?
  crv        String?
  n          String?
  e          String?
  kty        String?
  kid        String?
  use        String?
}

// ────────────────────────────────────────────────────────────────────────────
// 19. StreamTicket - short-lived auth tokens for the SSE realtime layer.
// ────────────────────────────────────────────────────────────────────────────
// T-E2 (Week 6, 2026-09-04): the SSE endpoint needs to authenticate without
// driving every connection through the JwtAuthGuard + RLS interceptor stack
// (the EventSource browser API can't carry an Authorization header and can't
// run SET LOCAL on its long-lived connection cheaply). The compromise:
//
//   - POST /api/realtime/ticket  (JWT-authed) mints a single-use StreamTicket
//     row scoped to (userId, channel). 5-minute TTL - long enough for a
//     realistic chat session, short enough that ticket leakage is bounded.
//   - GET /api/sse/<channel>?ticket=<id>  (ticket-authed) consumes the row,
//     opens the SSE stream, and uses the user's JWT identity (stored on the
//     row at mint time) to scope every query.
//
// Single-use is enforced by the controller deleting the row on connect. The
// `channel` column is a freeform string with a small fixed vocabulary:
//   "notifications"         - current user's Notification inbox
//   "audit"                 - current user's AuditLog visibility
//   "chat:<leadId>"         - Message stream for a specific lead
//
// Channel-scope checks happen at the mint endpoint (withRlsContext as the
// actor - the role gates which channels the user can ask for). The SSE
// controller itself uses the bare prisma client (with the actor's userId
// baked into the URL), so RLS still gates the actual data.
//
// We deliberately do NOT add an RLS policy for StreamTicket. The table is an
// auth-bypass surface: the ticket IS the credential for the SSE path. The
// only legitimate writer is the mint endpoint (which writes with the
// actor's role set); the only legitimate reader is the SSE controller
// (which deletes the row on consume). Forcing RLS here would add a join
// for no security gain - the ticket's cuid is unguessable and its TTL is
// bounded. The GRANTs go to shadhil_app so the pooled path can read/write.
model StreamTicket {
  id             String   @id @default(cuid())
  userId         String
  // T-ORG (eng review Finding 2): the ticket carries the org at mint
  // time. The SSE consumer compares ticket.orgId to the requested
  // channel's org and rejects a cross-org ticket before opening the
  // stream - this is what prevents cross-tenant SSE leakage via the
  // bare-client fetchers.
  organizationId String
  channel        String
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([expiresAt])
}

// ────────────────────────────────────────────────────────────────────────────
// T-E2b (2026-09-04): WhatsappUnknownContact
// ────────────────────────────────────────────────────────────────────────────
// When a lead we don't know about messages us on WhatsApp, we can't
// auto-create a Lead (per the T-E2b product decision: don't create
// Leads on unknown inbound). But we DO need to capture the number
// so a telecaller can follow up - otherwise the contact is lost.
//
// This table is the dedup-by-phone, admin-visible "pending follow-up"
// queue. One row per phone; multiple messages from the same number
// bump `lastMessageAt` and `messageCount` rather than creating new
// rows. Lifecycle:
//   PENDING  - fresh inbound; telecaller hasn't seen it yet
//   CONVERTED - telecaller called, real lead; `convertedToLeadId` set
//   SPAM     - not a real person; ignored
// Week 8+ ships the admin UI to process these. For now, the row
// exists and is queryable via psql - a real lead is not lost.
model WhatsappUnknownContact {
  id                String                       @id @default(cuid())
  phoneE164         String                       @unique
  // T-ORG: this is the ONE intentionally-nullable org column (eng review
  // Finding 3, option A). An unknown inbound has no org until a staff
  // member resolves/converts it. PENDING/SPAM rows may be org-less.
  organizationId    String?
  firstMessageAt    DateTime
  lastMessageAt     DateTime
  messageCount      Int                          @default(1)
  firstMessageBody  String?                      @db.Text
  status            WhatsappUnknownContactStatus @default(PENDING)
  // When status = CONVERTED, this links to the Lead that was created
  // from this contact. Nullable for PENDING and SPAM.
  convertedToLeadId String?                      @unique
  notes             String?                      @db.Text
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // T-WA-INBOX (2026-09-25): the real message history for this number.
  // Before this, an unknown contact had only messageCount + firstMessageBody,
  // so the conversation could not be reconstructed or displayed.
  messages         Message[]
  outboundMessages OutboundMessage[]
  readStates       ChatReadState[]

  @@index([organizationId])
  @@index([status])
  @@index([lastMessageAt])
}

enum WhatsappUnknownContactStatus {
  PENDING
  CONVERTED
  SPAM
}
