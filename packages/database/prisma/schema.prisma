// ────────────────────────────────────────────────────────────────────────────
// Shadhil Builders CRM — Prisma schema
// ────────────────────────────────────────────────────────────────────────────
// 18 business models + 4 better-auth tables (User, Session, Account, Verification).
// User is shared between better-auth and the business layer (single source of truth).
//
// Datasource notes:
// - CLI datasource url lives in prisma.config.ts (Prisma 7: no url in schema).
// - Direct migration URL: DIRECT_DATABASE_URL (owner role; bypasses PgBouncer
//   so SET LOCAL session variables for RLS work reliably).
// - Runtime queries via PgBouncer use DATABASE_URL + withRlsContext() through
//   the @prisma/adapter-pg driver adapter (POOL_MODE must be 'session').
//
// Money: Decimal(12,2) — never Float.
// IDs: cuid() — short, sortable, URL-safe.
// ────────────────────────────────────────────────────────────────────────────

generator client {
  // Prisma 7 default generator (the old `prisma-client-js` is in maintenance
  // mode and will be removed). Emits plain TypeScript into a normal source
  // path — no more magic generation into `node_modules/.prisma/client`, no
  // more `ERR_UNSUPPORTED_DIR_IMPORT` from the consumer's bare-directory
  // import.
  //
  // moduleFormat: "cjs" — the whole backend toolchain (nest build + node
  // dist/main.js) is CommonJS; CJS require() resolves the generated code's
  // bare relative imports natively. (With "esm" the generator emits bare
  // ESM imports that Node ESM rejects.)
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
}

// ────────────────────────────────────────────────────────────────────────────
// Enums
// ────────────────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  MANAGER
  SALES_EXEC
  TELECALLER
}

enum LeadState {
  NEW
  CONTACTED
  VISIT_REQUESTED
  VISIT_SCHEDULED
  VISITED
  NEGOTIATION
  BOOKING_INITIATED
  WON
  LOST
  COLD
  RESCHEDULED
  NO_SHOW
}

enum LeadOwnerType {
  TELECALLER
  SALES_EXEC
  MANAGER
  ADMIN
}

enum ActivityType {
  CALL
  NOTE
  STATUS_CHANGE
  VISIT
  EMAIL
}

enum VisitStatus {
  SCHEDULED
  RESCHEDULED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum MessageDirection {
  IN
  OUT
}

enum MessageChannel {
  WHATSAPP
  IN_APP
}

enum BookingStatus {
  HOLD
  TOKEN
  APPROVED
  REJECTED
  CANCELLED
}

enum UnitStatus {
  AVAILABLE
  HOLD
  TOKEN
  SOLD
}

enum ReminderType {
  PRE_VISIT_STAFF
  PRE_VISIT_CUSTOMER
  RESCHEDULE_FOLLOWUP
  NO_SHOW_STAFF
}

enum ReminderStatus {
  SCHEDULED
  // T-G4: PROCESSING is the intermediate state during a cron's lease.
  // The processor claims rows by updateMany(SCHEDULED → PROCESSING) so a
  // second cron tick (different replica, lock expired) sees zero rows
  // and exits cleanly — no duplicate fire.
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum PushPlatform {
  WEB
  IOS
  ANDROID
}

enum PushStatus {
  PENDING
  DELIVERED
  FAILED
}

enum ConsentType {
  MARKETING
  DATA_PROCESSING
  COMMUNICATION
}

enum WebhookSource {
  WHATSAPP
  FREJUN
}

// ────────────────────────────────────────────────────────────────────────────
// 1. User (better-auth shape + business relations)
// ────────────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String
  image         String?
  phone         String?
  role          Role     @default(TELECALLER)
  teamId        String?
  // T-S hardening (2026-09-04): a placeholder-password gate.
  // Seeded users (owner/admin/manager/telecaller/sales_exec) keep
  // mustChangePassword=true until they complete /change-password.
  // The demo user is exempted (mustChangePassword=false) so the
  // Sunday demo path works without a forced rotation.
  mustChangePassword Boolean @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // better-auth relations
  sessions Session[]
  accounts Account[]

  // business relations
  team              Team?              @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  managedTeams      Team[]             @relation("TeamManager")
  defaultAssigneeOf Team[]             @relation("TeamDefaultAssignee")
  ownedLeads        Lead[]             @relation("LeadOwner")
  coOwnedLeads      Lead[]             @relation("LeadCoOwner")
  activities        Activity[]
  messages          Message[]
  reminders         Reminder[]
  notifications     Notification[]
  siteVisits        SiteVisit[]
  bookingsCreated   Booking[]          @relation("BookingCreatedBy")
  bookingsApproved  Booking[]          @relation("BookingApprovedBy")
  pushSubscriptions PushSubscription[]
  pushNotifications PushNotification[]
  auditLogs         AuditLog[]

  @@index([teamId])
  @@index([role])
  @@index([email])
  banned         Boolean?
  banReason      String?
  banExpires     DateTime?

  // better-auth admin() plugin fields (AR-8: required by admin plugin user model)
}

// ────────────────────────────────────────────────────────────────────────────
// 2. Team
// ────────────────────────────────────────────────────────────────────────────

model Team {
  id                String   @id @default(cuid())
  name              String
  managerId         String?
  // T-ARM-SCHEMA (2026-09-04): per-team fallback assignee. The
  // ManagerAssignmentRule engine falls back to this user when no
  // rule matches the lead's criteria. The target must still be
  // TELECALLER or SALES_EXEC (the engine rejects ADMIN/MANAGER).
  // nullable: a team without a default assignee → leads that don't
  // match any rule stay unassigned (notification trigger fires).
  defaultAssigneeId String?
  createdAt         DateTime @default(now())

  manager         User?                   @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  defaultAssignee User?                   @relation("TeamDefaultAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)
  members         User[]                  @relation("TeamMembers")
  leads           Lead[]
  assignmentRules ManagerAssignmentRule[]

  @@index([managerId])
  @@index([defaultAssigneeId])
}

// ────────────────────────────────────────────────────────────────────────────
// 3. ManagerAssignmentRule (auto-routing)
// ────────────────────────────────────────────────────────────────────────────

model ManagerAssignmentRule {
  id           String   @id @default(cuid())
  teamId       String
  source       String // e.g. "meta_ads", "website", "referral"
  targetUserId String
  // T-ARM-SCHEMA (2026-09-04, Plan §18 D2): priority-ordered routing.
  // Lower number = higher priority (CSS-like). Two rules with the same
  // priority fall through to createdAt ASC tiebreak. Default 0 so the
  // existing single-rule setup behaves identically.
  priority     Int      @default(0)
  // Optional criteria — when present, the rule only matches leads where
  // the same attribute equals this value. NULL = wildcard (rule matches
  // any value). All four columns are independent: a rule with
  // projectId="A" AND phaseId=null matches leads in project A regardless
  // of phase. Combined with the priority ordering, a team can declare:
  //   (priority 10, projectId=A, source=META_AD) → senior TC
  //   (priority 20, projectId=A)                → TC pool
  //   (priority 30)                             → catch-all
  projectId    String?
  phaseId      String?
  language     String? // ISO 639-1 short code: "en", "hi", "ta"
  region       String? // ISO 3166-1 / UN region: "IN-TN", "IN-KA"
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  // Composite unique — the previous [teamId, source] constraint forced
  // one rule per (team, source). The widened constraint lets a team
  // declare multiple rules for the same source differentiated by
  // priority + criteria (e.g. "META_AD on project A" vs "META_AD on
  // project B" both coexist).
  @@unique([teamId, source, priority, projectId, phaseId, language, region], name: "teamId_source_priority_projectId_phaseId_language_region")
  @@index([teamId])
  @@index([targetUserId])
  @@index([priority])
}

// ────────────────────────────────────────────────────────────────────────────
// 4. Project
// ────────────────────────────────────────────────────────────────────────────

model Project {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  address    String
  reraNumber String?
  cmdaNumber String?
  createdAt  DateTime @default(now())

  phases Phase[]
  leads  Lead[]

  @@index([slug])
}

// ────────────────────────────────────────────────────────────────────────────
// 5. Phase
// ────────────────────────────────────────────────────────────────────────────

model Phase {
  id        String   @id @default(cuid())
  projectId String
  name      String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  units   Unit[]

  @@index([projectId])
}

// ────────────────────────────────────────────────────────────────────────────
// 6. Unit (money lives here — Decimal(12,2))
// ────────────────────────────────────────────────────────────────────────────

model Unit {
  id         String     @id @default(cuid())
  phaseId    String
  unitNumber String
  bhk        Int
  facing     String?
  sqft       Int?
  price      Decimal    @db.Decimal(12, 2)
  status     UnitStatus @default(AVAILABLE)
  createdAt  DateTime   @default(now())

  phase    Phase     @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([phaseId, unitNumber])
  @@index([phaseId])
  @@index([status])
}

// ────────────────────────────────────────────────────────────────────────────
// 7. Lead (core CRM entity)
// ────────────────────────────────────────────────────────────────────────────

model Lead {
  id        String        @id @default(cuid())
  name      String
  phone     String        @unique
  email     String?
  source    String?
  state     LeadState     @default(NEW)
  ownerId   String
  ownerType LeadOwnerType
  coOwnerId String?
  teamId    String
  projectId String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  owner      User        @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  coOwner    User?       @relation("LeadCoOwner", fields: [coOwnerId], references: [id], onDelete: SetNull)
  team       Team        @relation(fields: [teamId], references: [id], onDelete: Restrict)
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  activities Activity[]
  visits     SiteVisit[]
  messages   Message[]
  bookings   Booking[]
  reminders  Reminder[]
  consents   Consent[]

  @@index([ownerId])
  @@index([coOwnerId])
  @@index([teamId])
  @@index([state])
  @@index([projectId])
  @@index([createdAt])
}

// ────────────────────────────────────────────────────────────────────────────
// 8. Activity (timeline entries on a Lead)
// ────────────────────────────────────────────────────────────────────────────

model Activity {
  id        String       @id @default(cuid())
  leadId    String
  userId    String
  type      ActivityType
  body      String       @db.Text
  createdAt DateTime     @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// ────────────────────────────────────────────────────────────────────────────
// 9. SiteVisit
// ────────────────────────────────────────────────────────────────────────────

model SiteVisit {
  id           String      @id @default(cuid())
  leadId       String
  userId       String
  scheduledFor DateTime
  status       VisitStatus @default(SCHEDULED)
  outcome      String?     @db.Text
  notes        String?     @db.Text
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([userId])
  @@index([scheduledFor])
  @@index([status])
}

// ────────────────────────────────────────────────────────────────────────────
// 10. Message (WhatsApp + in-app; used for SSE resume via createdAt)
// ────────────────────────────────────────────────────────────────────────────

model Message {
  id         String           @id @default(cuid())
  leadId     String
  userId     String? // null = inbound from customer
  direction  MessageDirection
  channel    MessageChannel
  body       String           @db.Text
  mediaUrl   String?
  externalId String? // WhatsApp message id (for dedupe / status sync)
  createdAt  DateTime         @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([userId])
  @@index([channel, createdAt])
  @@index([externalId])
}

// ────────────────────────────────────────────────────────────────────────────
// 11. Booking (lead × unit; money Decimal(12,2))
// ────────────────────────────────────────────────────────────────────────────

model Booking {
  id           String        @id @default(cuid())
  leadId       String
  unitId       String
  userId       String // who created the booking
  amount       Decimal       @db.Decimal(12, 2)
  status       BookingStatus @default(HOLD)
  tokenAmount  Decimal?      @db.Decimal(12, 2)
  approvedById String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  lead       Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  unit       Unit  @relation(fields: [unitId], references: [id], onDelete: Restrict)
  user       User  @relation("BookingCreatedBy", fields: [userId], references: [id], onDelete: Restrict)
  approvedBy User? @relation("BookingApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([unitId])
  @@index([userId])
  @@index([status])
}

// ────────────────────────────────────────────────────────────────────────────
// 12. Reminder
// ────────────────────────────────────────────────────────────────────────────

model Reminder {
  id           String         @id @default(cuid())
  leadId       String
  userId       String
  type         ReminderType
  status       ReminderStatus @default(SCHEDULED)
  scheduledFor DateTime
  sentAt       DateTime?
  // T-G4: claim bookkeeping. When the cron claims a row (updateMany
  // SCHEDULED → PROCESSING), it sets claimedAt + claimedBy (replica id).
  // A stuck PROCESSING row (cron died mid-fire) can be recovered by:
  //   UPDATE "Reminder" SET status = 'SCHEDULED', claimedAt = NULL
  //   WHERE status = 'PROCESSING' AND claimedAt < NOW() - INTERVAL '5m'
  // The recovery job ships separately (post-Week 7 reminders module);
  // for now, a manual query is sufficient.
  claimedAt    DateTime?
  claimedBy    String?
  createdAt    DateTime       @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([userId])
  @@index([status])
  @@index([scheduledFor])
  @@index([status, scheduledFor])
}

// ────────────────────────────────────────────────────────────────────────────
// 13. Notification (in-app inbox — supersedes the dropped InAppNotification)
// ────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // free-form: "lead.assigned", "visit.scheduled", etc.
  title     String
  body      String   @db.Text
  leadId    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

// ────────────────────────────────────────────────────────────────────────────
// 14. PushSubscription (web push per-device endpoint)
// ────────────────────────────────────────────────────────────────────────────

model PushSubscription {
  id        String       @id @default(cuid())
  userId    String
  endpoint  String       @unique
  p256dh    String
  auth      String
  platform  PushPlatform
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ────────────────────────────────────────────────────────────────────────────
// 15. PushNotification (delivery log)
// ────────────────────────────────────────────────────────────────────────────

model PushNotification {
  id        String     @id @default(cuid())
  userId    String
  type      String
  payload   Json
  status    PushStatus @default(PENDING)
  sentAt    DateTime?
  error     String?    @db.Text
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ────────────────────────────────────────────────────────────────────────────
// 16. AuditLog (before/after JSON snapshots)
// ────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String // "lead.update", "booking.approve", etc.
  entityType String
  entityId   String
  before     Json?
  after      Json?
  reason     String?  @db.Text
  ipAddress  String?
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

// ────────────────────────────────────────────────────────────────────────────
// 17. Consent (RERA / DPDP compliance trail)
// ────────────────────────────────────────────────────────────────────────────

model Consent {
  id          String      @id @default(cuid())
  leadId      String
  consentType ConsentType
  granted     Boolean
  grantedAt   DateTime
  ipAddress   String?
  source      String // "web_form", "call_verbal", "whatsapp_button", etc.
  createdAt   DateTime    @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([consentType])
}

// ────────────────────────────────────────────────────────────────────────────
// 18. WebhookEvent (WhatsApp / FreJun inbound; idempotent via externalId)
// ────────────────────────────────────────────────────────────────────────────

model WebhookEvent {
  id          String        @id @default(cuid())
  source      WebhookSource
  externalId  String        @unique
  payload     Json
  processed   Boolean       @default(false)
  processedAt DateTime?
  error       String?       @db.Text
  createdAt   DateTime      @default(now())

  @@index([source])
  @@index([processed])
}

// ────────────────────────────────────────────────────────────────────────────
// better-auth tables (Session / Account / Verification)
// User is shared (defined above) — single source of truth.
// ────────────────────────────────────────────────────────────────────────────

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model Account {
  id           String    @id @default(cuid())
  userId       String
  accountId    String
  providerId   String
  // better-auth >=1.7 writes issuer on credential accounts ("local:credential")
  issuer       String?
  accessToken  String?   @db.Text
  refreshToken String?   @db.Text
  idToken      String?   @db.Text
  expiresAt    DateTime?
  password     String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

// Jwks — required by better-auth's jwt() plugin (HS256 mode still creates the
// key store lazily on first token request). Its absence breaks
// GET /api/auth/get-session with "Model jwks does not exist" (500), which
// takes down authClient.useSession() across the web UI. Column set follows
// better-auth 1.7's jwt() plugin schema (publicKey/privateKey/createdAt
// required; expiresAt/alg/crv/n/e optional — they ARE written even in
// HS256/EdDSA lazy-key mode, so they must exist, not just be nullable).
model Jwks {
  id           String    @id @default(cuid())
  publicKey    String    @db.Text
  privateKey   String    @db.Text
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?
  alg          String?
  crv          String?
  n            String?
  e            String?
  kty          String?
  kid          String?
  use          String?
}
