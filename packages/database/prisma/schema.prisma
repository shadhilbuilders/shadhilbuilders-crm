// ────────────────────────────────────────────────────────────────────────────
// Shadhil Builders CRM — Prisma schema
// ────────────────────────────────────────────────────────────────────────────
// 18 business models + 4 better-auth tables (User, Session, Account, Verification).
// User is shared between better-auth and the business layer (single source of truth).
//
// Datasource notes:
// - url uses DIRECT_DATABASE_URL — bypasses PgBouncer so SET LOCAL session
//   variables for RLS work reliably. Migrations also use this URL.
// - For runtime queries via PgBouncer use `DATABASE_URL` + withRlsContext()
//   which sets per-transaction session vars (POOL_MODE must be 'session').
//
// Money: Decimal(12,2) — never Float.
// IDs: cuid() — short, sortable, URL-safe.
// ────────────────────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
  // Generate into the package's own node_modules so types and runtime resolve
  // cleanly. The shadhil monorepo generates one Prisma client per package
  // and re-exports the types from src/index.ts.
  output          = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────────────────
// Enums
// ────────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  SALES_EXEC
  TELECALLER
}

enum LeadState {
  NEW
  CONTACTED
  VISIT_REQUESTED
  VISIT_SCHEDULED
  VISITED
  NEGOTIATION
  BOOKING_INITIATED
  WON
  LOST
  COLD
  RESCHEDULED
  NO_SHOW
}

enum LeadOwnerType {
  TELECALLER
  SALES_EXEC
  MANAGER
  ADMIN
}

enum ActivityType {
  CALL
  NOTE
  STATUS_CHANGE
  VISIT
  EMAIL
}

enum VisitStatus {
  SCHEDULED
  RESCHEDULED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum MessageDirection {
  IN
  OUT
}

enum MessageChannel {
  WHATSAPP
  IN_APP
}

enum BookingStatus {
  HOLD
  TOKEN
  APPROVED
  REJECTED
  CANCELLED
}

enum UnitStatus {
  AVAILABLE
  HOLD
  TOKEN
  SOLD
}

enum ReminderType {
  PRE_VISIT_STAFF
  PRE_VISIT_CUSTOMER
  RESCHEDULE_FOLLOWUP
  NO_SHOW_STAFF
}

enum ReminderStatus {
  SCHEDULED
  SENT
  FAILED
  CANCELLED
}

enum PushPlatform {
  WEB
  IOS
  ANDROID
}

enum PushStatus {
  PENDING
  DELIVERED
  FAILED
}

enum ConsentType {
  MARKETING
  DATA_PROCESSING
  COMMUNICATION
}

enum WebhookSource {
  WHATSAPP
  FREJUN
}

// ────────────────────────────────────────────────────────────────────────────
// 1. User (better-auth shape + business relations)
// ────────────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String
  image         String?
  phone         String?
  role          Role     @default(TELECALLER)
  teamId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // better-auth relations
  sessions Session[]
  accounts Account[]

  // business relations
  team              Team?              @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  managedTeams      Team[]             @relation("TeamManager")
  ownedLeads        Lead[]             @relation("LeadOwner")
  coOwnedLeads      Lead[]             @relation("LeadCoOwner")
  activities        Activity[]
  messages          Message[]
  reminders         Reminder[]
  notifications     Notification[]
  siteVisits        SiteVisit[]
  bookingsCreated   Booking[]          @relation("BookingCreatedBy")
  bookingsApproved  Booking[]          @relation("BookingApprovedBy")
  pushSubscriptions PushSubscription[]
  pushNotifications PushNotification[]
  auditLogs         AuditLog[]

  @@index([teamId])
  @@index([role])
  @@index([email])
}

// ────────────────────────────────────────────────────────────────────────────
// 2. Team
// ────────────────────────────────────────────────────────────────────────────

model Team {
  id        String   @id @default(cuid())
  name      String
  managerId String?
  createdAt DateTime @default(now())

  manager         User?                   @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  members         User[]                  @relation("TeamMembers")
  leads           Lead[]
  assignmentRules ManagerAssignmentRule[]

  @@index([managerId])
}

// ────────────────────────────────────────────────────────────────────────────
// 3. ManagerAssignmentRule (auto-routing)
// ────────────────────────────────────────────────────────────────────────────

model ManagerAssignmentRule {
  id           String   @id @default(cuid())
  teamId       String
  source       String // e.g. "meta_ads", "website", "referral"
  targetUserId String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, source])
  @@index([teamId])
  @@index([targetUserId])
}

// ────────────────────────────────────────────────────────────────────────────
// 4. Project
// ────────────────────────────────────────────────────────────────────────────

model Project {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  address    String
  reraNumber String?
  cmdaNumber String?
  createdAt  DateTime @default(now())

  phases Phase[]
  leads  Lead[]

  @@index([slug])
}

// ────────────────────────────────────────────────────────────────────────────
// 5. Phase
// ────────────────────────────────────────────────────────────────────────────

model Phase {
  id        String   @id @default(cuid())
  projectId String
  name      String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  units   Unit[]

  @@index([projectId])
}

// ────────────────────────────────────────────────────────────────────────────
// 6. Unit (money lives here — Decimal(12,2))
// ────────────────────────────────────────────────────────────────────────────

model Unit {
  id         String     @id @default(cuid())
  phaseId    String
  unitNumber String
  bhk        Int
  facing     String?
  sqft       Int?
  price      Decimal    @db.Decimal(12, 2)
  status     UnitStatus @default(AVAILABLE)
  createdAt  DateTime   @default(now())

  phase    Phase     @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([phaseId, unitNumber])
  @@index([phaseId])
  @@index([status])
}

// ────────────────────────────────────────────────────────────────────────────
// 7. Lead (core CRM entity)
// ────────────────────────────────────────────────────────────────────────────

model Lead {
  id        String        @id @default(cuid())
  name      String
  phone     String        @unique
  email     String?
  source    String?
  state     LeadState     @default(NEW)
  ownerId   String
  ownerType LeadOwnerType
  coOwnerId String?
  teamId    String
  projectId String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  owner      User        @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  coOwner    User?       @relation("LeadCoOwner", fields: [coOwnerId], references: [id], onDelete: SetNull)
  team       Team        @relation(fields: [teamId], references: [id], onDelete: Restrict)
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  activities Activity[]
  visits     SiteVisit[]
  messages   Message[]
  bookings   Booking[]
  reminders  Reminder[]
  consents   Consent[]

  @@index([ownerId])
  @@index([coOwnerId])
  @@index([teamId])
  @@index([state])
  @@index([projectId])
  @@index([createdAt])
}

// ────────────────────────────────────────────────────────────────────────────
// 8. Activity (timeline entries on a Lead)
// ────────────────────────────────────────────────────────────────────────────

model Activity {
  id        String       @id @default(cuid())
  leadId    String
  userId    String
  type      ActivityType
  body      String       @db.Text
  createdAt DateTime     @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// ────────────────────────────────────────────────────────────────────────────
// 9. SiteVisit
// ────────────────────────────────────────────────────────────────────────────

model SiteVisit {
  id           String      @id @default(cuid())
  leadId       String
  userId       String
  scheduledFor DateTime
  status       VisitStatus @default(SCHEDULED)
  outcome      String?     @db.Text
  notes        String?     @db.Text
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([userId])
  @@index([scheduledFor])
  @@index([status])
}

// ────────────────────────────────────────────────────────────────────────────
// 10. Message (WhatsApp + in-app; used for SSE resume via createdAt)
// ────────────────────────────────────────────────────────────────────────────

model Message {
  id         String           @id @default(cuid())
  leadId     String
  userId     String? // null = inbound from customer
  direction  MessageDirection
  channel    MessageChannel
  body       String           @db.Text
  mediaUrl   String?
  externalId String? // WhatsApp message id (for dedupe / status sync)
  createdAt  DateTime         @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([userId])
  @@index([channel, createdAt])
  @@index([externalId])
}

// ────────────────────────────────────────────────────────────────────────────
// 11. Booking (lead × unit; money Decimal(12,2))
// ────────────────────────────────────────────────────────────────────────────

model Booking {
  id           String        @id @default(cuid())
  leadId       String
  unitId       String
  userId       String // who created the booking
  amount       Decimal       @db.Decimal(12, 2)
  status       BookingStatus @default(HOLD)
  tokenAmount  Decimal?      @db.Decimal(12, 2)
  approvedById String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  lead       Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  unit       Unit  @relation(fields: [unitId], references: [id], onDelete: Restrict)
  user       User  @relation("BookingCreatedBy", fields: [userId], references: [id], onDelete: Restrict)
  approvedBy User? @relation("BookingApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([unitId])
  @@index([userId])
  @@index([status])
}

// ────────────────────────────────────────────────────────────────────────────
// 12. Reminder
// ────────────────────────────────────────────────────────────────────────────

model Reminder {
  id           String         @id @default(cuid())
  leadId       String
  userId       String
  type         ReminderType
  status       ReminderStatus @default(SCHEDULED)
  scheduledFor DateTime
  sentAt       DateTime?
  createdAt    DateTime       @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([userId])
  @@index([status])
  @@index([scheduledFor])
}

// ────────────────────────────────────────────────────────────────────────────
// 13. Notification (in-app inbox — supersedes the dropped InAppNotification)
// ────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // free-form: "lead.assigned", "visit.scheduled", etc.
  title     String
  body      String   @db.Text
  leadId    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

// ────────────────────────────────────────────────────────────────────────────
// 14. PushSubscription (web push per-device endpoint)
// ────────────────────────────────────────────────────────────────────────────

model PushSubscription {
  id        String       @id @default(cuid())
  userId    String
  endpoint  String       @unique
  p256dh    String
  auth      String
  platform  PushPlatform
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ────────────────────────────────────────────────────────────────────────────
// 15. PushNotification (delivery log)
// ────────────────────────────────────────────────────────────────────────────

model PushNotification {
  id        String     @id @default(cuid())
  userId    String
  type      String
  payload   Json
  status    PushStatus @default(PENDING)
  sentAt    DateTime?
  error     String?    @db.Text
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ────────────────────────────────────────────────────────────────────────────
// 16. AuditLog (before/after JSON snapshots)
// ────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String // "lead.update", "booking.approve", etc.
  entityType String
  entityId   String
  before     Json?
  after      Json?
  reason     String?  @db.Text
  ipAddress  String?
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

// ────────────────────────────────────────────────────────────────────────────
// 17. Consent (RERA / DPDP compliance trail)
// ────────────────────────────────────────────────────────────────────────────

model Consent {
  id          String      @id @default(cuid())
  leadId      String
  consentType ConsentType
  granted     Boolean
  grantedAt   DateTime
  ipAddress   String?
  source      String // "web_form", "call_verbal", "whatsapp_button", etc.
  createdAt   DateTime    @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([consentType])
}

// ────────────────────────────────────────────────────────────────────────────
// 18. WebhookEvent (WhatsApp / FreJun inbound; idempotent via externalId)
// ────────────────────────────────────────────────────────────────────────────

model WebhookEvent {
  id          String        @id @default(cuid())
  source      WebhookSource
  externalId  String        @unique
  payload     Json
  processed   Boolean       @default(false)
  processedAt DateTime?
  error       String?       @db.Text
  createdAt   DateTime      @default(now())

  @@index([source])
  @@index([processed])
}

// ────────────────────────────────────────────────────────────────────────────
// better-auth tables (Session / Account / Verification)
// User is shared (defined above) — single source of truth.
// ────────────────────────────────────────────────────────────────────────────

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model Account {
  id           String    @id @default(cuid())
  userId       String
  accountId    String
  providerId   String
  accessToken  String?   @db.Text
  refreshToken String?   @db.Text
  idToken      String?   @db.Text
  expiresAt    DateTime?
  password     String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}
