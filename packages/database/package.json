{
  "name": "@shadhil/database",
  "version": "0.1.0",
  "private": true,
  "description": "Shadhil CRM — Prisma schema, generated client, and model type re-exports. Single source of truth for all Prisma-derived types consumed by @shadhil/api-types and the apps.",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && prisma generate",
    "dev": "tsc -p tsconfig.build.json --watch",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "studio": "prisma studio",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx --env-file=../../.env src/seed.ts",
    "format": "echo '(prisma format)' && prisma format",
    "docker:up": "cd ../../docker && docker compose --env-file ../.env up -d postgres pgbouncer redis"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prisma/client-runtime-utils": "7.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "dotenv": "^17.4.2",
    "prisma": "7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
