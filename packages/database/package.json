{
  "name": "@shadhil/database",
  "version": "0.1.0",
  "private": true,
  "description": "Shadhil CRM \u2014 Prisma schema, generated client, and model type re-exports. Single source of truth for all Prisma-derived types consumed by @shadhil/api-types and the apps.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "studio": "prisma studio",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx --env-file=../../.env src/seed.ts",
    "format": "echo '(prisma format)' && prisma format",
    "docker:up": "cd ../../docker && docker compose up -d postgres pgbouncer redis"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "dotenv": "^16.4.5",
    "prisma": "^5.22.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "tsx": "^4.23.0"
  }
}