{
  "name": "@shadhil/ui-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Shadhil Builders brand tokens (CSS) and compliance helpers. Single source of truth for navy/green/off-white brand surface and Inter font across web, mobile, and backend console.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./brand.css": "./src/brand.css",
    "./fonts.css": "./src/fonts.css",
    "./compliance": {
      "types": "./src/compliance.ts",
      "import": "./src/compliance.ts",
      "default": "./src/compliance.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}