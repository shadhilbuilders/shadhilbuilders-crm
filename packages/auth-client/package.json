{
  "name": "@shadhil/auth",
  "version": "0.1.0",
  "private": true,
  "description": "better-auth shared instance with Prisma adapter, JWT + admin plugins. Shared between apps/web (Next.js) and apps/backend (NestJS).",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./auth-client": {
      "types": "./dist/auth-client.d.ts",
      "require": "./dist/auth-client.js",
      "import": "./dist/auth-client.js",
      "default": "./dist/auth-client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo",
    "type-check": "tsc --noEmit",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@shadhil/database": "workspace:*",
    "better-auth": "^1.2.0",
    "jose": "^6.2.10",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
