{
  "name": "@shadhil/auth",
  "version": "0.1.0",
  "private": true,
  "description": "better-auth shared instance with Prisma adapter, JWT + admin plugins. Shared between apps/web (Next.js) and apps/backend (NestJS).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@shadhil/database": "workspace:*",
    "better-auth": "^1.2.0",
    "jose": "^5.9.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
