{
  "name": "@shadhil/auth",
  "version": "0.1.0",
  "private": true,
  "description": "better-auth shared instance with Prisma adapter, JWT + admin plugins. Shared between apps/web (Next.js) and apps/backend (NestJS).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@shadhil/database": "workspace:*",
    "better-auth": "^1.2.0",
    "jose": "^6.2.10",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
