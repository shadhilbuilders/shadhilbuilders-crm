{
  "name": "@shadhil/api-types",
  "version": "0.1.0",
  "private": true,
  "description": "Shadhil CRM — Shared TypeScript types and Zod schemas for the 9 NestJS modules. Re-exports Prisma-generated model types from @shadhil/database and provides request/response DTOs as Zod schemas (inferred TypeScript types via z.infer). One source of truth for validation in NestJS pipes AND Next.js route handlers.",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "test"
  ],
  "scripts": {
    "type-check": "tsc --noEmit",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "prebuild": "pnpm --filter @shadhil/database build",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@shadhil/database": "workspace:*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
