# Shadhil Builders CRM - environment template
# Copy to .env and fill values:  cp .env.example .env
# NEVER commit real .env - .gitignore already excludes it.
# Generate secrets with:            openssl rand -base64 32

# ── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=8080
WEB_PORT=3000

# ── Database (dev defaults match docker/docker-compose.yml) ─────────────────
# Pooled path - the API connects as the NON-OWNER role `shadhil_app`
# (RLS-enforced; see docker/postgres-init/00-init.sql).
DATABASE_URL=postgresql://shadhil_app:shadhil@localhost:6432/shadhil_crm?schema=public
# Owner-role direct URL - migrations + seed ONLY. Bypasses RLS by design.
DIRECT_DATABASE_URL=postgresql://shadhil:***@localhost:5432/shadhil_crm?schema=public
#
# ── TESTS USE A SEPARATE DATABASE ────────────────────────────────────────────
# You do NOT point these at a test database by hand. Every vitest setup file
# rewrites the database NAME to `<name>_test` and moves the pooled URL to the
# direct postgres port (PgBouncer only routes shadhil_crm), then VERIFIES the
# result - refusing to run if it is not a `_test` database. See
# packages/database/src/test-db-isolation.ts.
#
# That is what keeps fixtures out of your development data: DB-backed suites
# create and delete real rows, and 141 orphaned leads once accumulated here.
#
#   pnpm db:test:reset     # (re)create shadhil_crm_test: migrate + seed
#
# Set TEST_DB_ALLOW_DEV=1 to opt out (the e2e job does this deliberately).
# AR-1: MUST be 'session'. Transaction pooling silently breaks RLS - NestJS
# boot-check fails startup otherwise.
POOL_MODE=session

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth (better-auth) - 32+ chars, openssl rand -base64 32 ─────────────────
BETTER_AUTH_SECRET=CHANGE_ME_openssl_rand_base64_32_xxxxxxxxxxxxxx
BETTER_AUTH_URL=http://localhost:3000

# ── JWT bridge (placeholder parity with compose; NestJS currently derives
# from BETTER_AUTH_SECRET - see plan AR-8 note on the dual-secret design) ────
JWT_SECRET=CHANGE_ME_openssl_rand_base64_32_xxxxxxxxxxxxx

# ── Web ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_APP_NAME="Shadhil CRM"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Shared public API key (both anonymous public endpoints) ────────────────
# Guards POST /api/public/feedback AND POST /api/public/leads (the landing
# page submits community feedback + enquiries here instead of Supabase/Sheets
# mirror). One key keeps config simple. Keep it out of NEXT_PUBLIC_. Generate:
#   openssl rand -hex 32
# The landing page's CRM_PUBLIC_URL / CRM_PUBLIC_API_KEY must hold your URL +
# this same value.
PUBLIC_API_KEY=CHANGE_ME_openssl_rand_hex_32_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Organization ID for anonymous public writes (feedback + leads). Both public
# endpoints run their inserts under a synthetic RLS context that scopes to
# this org. Required at boot (fail-fast — a wrong tenant must never silently
# receive a public write). Valid: 26-char ULID (like the other org ids) or
# 36-char UUID.
PUBLIC_ORG_ID=CHANGE_ME_<org_ulid_or_uuid>
# LEADS_FALLBACK_OWNER_ID (recommended): a real staff user id
# (TELECALLER/SALES_EXEC) that gets a landing enquiry when the manager
# assignment engine matches no rule AND the team has no default assignee.
# Without it the public leads endpoint returns 400 for un-routable enquiries.
LEADS_FALLBACK_OWNER_ID=
# LEADS_FALLBACK_PROJECT_ID (recommended): a real Project id (cuid2) that
# landing leads land on when the landing page sends no projectSlug. If unset,
# leads get projectId=null. Ignored (never a 400) - resolves to null when the
# id doesn't exist or isn't in PUBLIC_ORG_ID.
LEADS_FALLBACK_PROJECT_ID=

# ── CORS (prod; local dev falls back to localhost defaults) ─────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ── Client-input integrations (plan §17 - placeholder until Shadhil sends) ──
# WA_PHONE_NUMBER_ID=
# WA_BUSINESS_ACCOUNT_ID=
# WA_ACCESS_TOKEN=
# WA_WEBHOOK_VERIFY_TOKEN=
# FREJUN_API_KEY=
# FREJUN_WEBHOOK_SECRET=
# FREJUN_AGENT_NUMBER=
# NEXT_PUBLIC_RERA_NUMBER=
# NEXT_PUBLIC_CMDA_NUMBER=

# ── Seed (optional - falls back to documented placeholder users) ────────────
# SEED_OWNER_EMAIL=
# SEED_OWNER_NAME=
# SEED_OWNER_PASSWORD=
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_NAME=
# SEED_ADMIN_PASSWORD=
# SEED_MANAGER_EMAIL=
# SEED_MANAGER_NAME=
# SEED_MANAGER_PASSWORD=
# SEED_TELECALLER_EMAIL=
# SEED_TELECALLER_NAME=
# SEED_TELECALLER_PASSWORD=
# SEED_SALES_EXEC_EMAIL=
# SEED_SALES_EXEC_NAME=
# SEED_SALES_EXEC_PASSWORD=
# ── T-E2b Telegram alert (optional - alerts module no-ops if missing) ───────
# Bot created via @BotFather. Token looks like 'NNNNNNNNN:AAAA...'.
# Add the bot as admin to the target channel, then read the channel id
# from the bot's own channel-post history (looks like -100xxxxxxxxxx).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHANNEL_ID=
# TELEGRAM_BOT_NAME=ShadhilCRMAlertsBot
# TELEGRAM_ALERT_THRESHOLD=3
# TELEGRAM_ALERT_COOLDOWN_MS=900000
