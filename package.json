{
  "name": "shadhil-crm",
  "version": "0.1.0",
  "private": true,
  "description": "Shadhil Builders CRM - Next.js 16 + NestJS 12 + Prisma monorepo",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=\"./packages/*\"",
    "dev": "turbo run dev",
    "dev:queries": "pnpm --filter @shadhil/backend dev:queries",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "type-check": "turbo run type-check",
    "test": "turbo run test --concurrency=1",
    "test:e2e": "pnpm --filter @shadhil/web test:e2e --project=chromium",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "db:generate": "pnpm --filter @shadhil/database generate",
    "db:migrate": "pnpm --filter @shadhil/database migrate",
    "db:seed": "pnpm --filter @shadhil/database seed",
    "db:setup-demo-user": "pnpm --filter @shadhil/database setup-demo-user",
    "db:test:reset": "pnpm --filter @shadhil/database test:db:reset",
    "db:studio": "pnpm --filter @shadhil/database studio",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md,mdx}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md,mdx}\" --cache",
    "design:detect": "impeccable detect apps/web packages/ui-tokens/src",
    "design:detect:ci": "impeccable detect apps/web packages/ui-tokens/src --github",
    "docker:up": "pnpm --filter @shadhil/database docker:up",
    "docker:stack": "docker compose --env-file .env -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose --env-file .env -f docker/docker-compose.yml down",
    "docker:logs": "docker compose --env-file .env -f docker/docker-compose.yml logs -f",
    "docker:restart": "docker compose --env-file .env -f docker/docker-compose.yml restart",
    "db:policies": "docker exec -i shadhil-postgres psql -U shadhil -d shadhil_crm -v ON_ERROR_STOP=1 < packages/database/prisma/rls/policies.sql"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "impeccable": "4.8.2",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  }
}
