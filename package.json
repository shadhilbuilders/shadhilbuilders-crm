{
  "name": "shadhil-crm",
  "version": "0.1.0",
  "private": true,
  "description": "Shadhil Builders CRM — Next.js 16 + NestJS 12 + Prisma monorepo",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "db:generate": "pnpm --filter @shadhil/database generate",
    "db:migrate": "pnpm --filter @shadhil/database migrate",
    "db:studio": "pnpm --filter @shadhil/database studio",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md,mdx}\" --cache"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}